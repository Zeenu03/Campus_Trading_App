# ============================================================
# Campus Trading App - Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# MySQL connection
DB_HOST=10.0.116.184
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=Optimiser

# Optional shard endpoints for Task 1-style deployments.
# Use the assigned database name on each shard host unless your instructor tells you otherwise.
SHARD_0_HOST=10.0.116.184
SHARD_0_PORT=3307
SHARD_0_DB_NAME=Optimiser
SHARD_1_HOST=10.0.116.184
SHARD_1_PORT=3308
SHARD_1_DB_NAME=Optimiser
SHARD_2_HOST=10.0.116.184
SHARD_2_PORT=3309
SHARD_2_DB_NAME=Optimiser

# Alternatively, set the full DSN directly (overrides above):
# DB_DSN=root:password@tcp(10.0.116.184:3306)/Optimiser?parseTime=true&charset=utf8mb4

# Go backend
PORT=8080
# Exact browser origin(s). Must match how you open the app (localhost vs LAN IP are different origins).
# Comma-separated for dev: e.g. http://localhost:5173,http://10.7.9.7:5173
FRONTEND_URL=http://localhost:5173
AUDIT_LOG_PATH=./logs/audit.log

# SuperAdmin seed (used by: go run ./backend/cmd/seed)
SUPERADMIN_EMAIL=superadmin@iitgn.ac.in
SUPERADMIN_PASSWORD=Admin@iitgn2025
SUPERADMIN_NAME=Super Administrator

UPLOADS_DIR=./uploads
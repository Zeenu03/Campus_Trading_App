# ============================================================
# Campus Trading App - Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# MySQL connection
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=CampusTradingB

# Alternatively, set the full DSN directly (overrides above):
# DB_DSN=root:password@tcp(localhost:3306)/CampusTradingB?parseTime=true&charset=utf8mb4&loc=UTC&time_zone=UTC

# Go backend
PORT=8080
# Exact browser origin(s). Must match how you open the app (localhost vs LAN IP are different origins).
# Comma-separated for dev: e.g. http://localhost:5173,http://10.7.9.7:5173
FRONTEND_URL=http://localhost:5173
AUDIT_LOG_PATH=./logs/audit.log

# SuperAdmin seed (used by: go run ./backend/cmd/seed)
SUPERADMIN_EMAIL=superadmin@iitgn.ac.in
SUPERADMIN_PASSWORD=Admin@iitgn2025
SUPERADMIN_NAME=Super Administrator

UPLOADS_DIR=./uploads